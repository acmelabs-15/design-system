{
 "note": "Three roots on the scroller page. `width` fixes both previews at 600px: the mirror's preview column is 152px wide against our docs page's much wider one, and the track's columns are sized from that width, so without it the column sizes differ by the container rather than by the element. The track's column sizes are also read as soft, because the columns follow their content, which is set in our own font.",
 "themes": [
  "light",
  "dark"
 ],
 "scroller-narrow": {
  "geist": {
   "side": "geist",
   "page": "scroller-narrow",
   "marker": "data-geist-scroller",
   "width": "600px",
   "children": {
    "overlay": ".overlay|[data-geist-scroller] > div:first-child",
    "before": ".before|[data-geist-scroller] > div:first-child > div:first-child",
    "after": ".after|[data-geist-scroller] > div:first-child > div:last-child",
    "container": ".container|[data-geist-scroller] > div:last-child",
    "content": ".content|[data-geist-scroller] > div:last-child > div"
   },
   "textParts": [
    "root",
    "overlay",
    "before",
    "after",
    "container",
    "content"
   ],
   "textProps": {
    "content": [
     "grid-template-columns",
     "__rect",
     "width"
    ]
   }
  },
  "ours": {
   "side": "ours",
   "page": "scroller-narrow",
   "host": "acme-scroller",
   "ours": ".scroller",
   "width": "600px",
   "children": {
    "overlay": ".overlay|[data-geist-scroller] > div:first-child",
    "before": ".before|[data-geist-scroller] > div:first-child > div:first-child",
    "after": ".after|[data-geist-scroller] > div:first-child > div:last-child",
    "container": ".container|[data-geist-scroller] > div:last-child",
    "content": ".content|[data-geist-scroller] > div:last-child > div"
   },
   "textParts": [
    "root",
    "overlay",
    "before",
    "after",
    "container",
    "content"
   ],
   "textProps": {
    "content": [
     "grid-template-columns",
     "__rect",
     "width"
    ]
   }
  }
 }
}
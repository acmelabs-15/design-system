      "ours": { "side": "ours", "page": "command-menu", "host": "acme-command-menu[id^=sk-]", "ours": "dialog[open]", "prepare": "(see prepare above)", "textParts": ["input", "esc", "label", "title", "desc", "emptyText", "query", "crumbList"], "textProps": { "esc": ["margin-left"] }, "children": { "backdrop": "::backdrop|^[cmdk-overlay]", "title": ".title|:scope > h2", "desc": ".desc|:scope > p", "root": ".root|[cmdk-root]", "label": ".label|[cmdk-label]", "head": ".head|[cmdk-root] > div:first-of-type", "crumbs": ".crumbs|.mb-2\\.5", "crumbList": ".crumbs acme-breadcrumbs >> .list|.mb-2\\.5 > div", "field": ".field|.justify-between", "input": ".input|[cmdk-input]", "esc": ".esc|.justify-between > button", "loading": ".loading|.after\\:absolute", "loadingAfter": ".loading::after|.after\\:absolute::after", "list": ".list|[cmdk-list]", "sizer": ".sizer|[cmdk-list-sizer]", "empty": ".empty|[cmdk-empty]", "emptyText": ".empty-text|[cmdk-empty] > p", "query": ".query|[cmdk-empty] span" } }

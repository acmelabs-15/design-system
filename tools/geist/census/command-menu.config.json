      "ours": { "side": "ours", "page": "command-menu-item", "host": "acme-command-menu[id^=sk-]", "each": true, "ours": "acme-command-item:not([hidden]) >> .item", "prepare": "(see prepare above)", "textParts": ["key", "suffix"], "textProps": { "keys": ["margin-left"], "suffix": ["margin-left"] }, "children": { "prefix": ".prefix|.size-5", "keys": ".keys|.hidden", "key": ".keys > kbd|.hidden > kbd", "suffix": ".suffix|.items-stretch" } }

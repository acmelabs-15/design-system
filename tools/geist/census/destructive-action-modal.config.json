{
  "note": "Two runs, both themes, geist on the mirror (http://localhost:4184/geist/destructive-action-modal) and ours on the census page (http://localhost:4180/census/destructive-action-modal: the page's four sections closed, then the five census-only sections, each opened on mount by its own example script; the public page shows the four sections only). Resize the pane to 1100x900 before loading either page. The root is the composed modal's panel (`acme-modal >> .modal` in ours), so the modal's own parts are read in this composition too; the closed page examples have no panel and pair to nothing, and the diff pairs the five open roots by order. Last run: 40 hard on each theme, all one difference: `body.min-width` and `actions.min-width` read 0px on the mirror and auto in ours, because the reference puts a <form> between the panel and its body and footer (they are block children of the form there, flex items of the panel's column in ours; `auto` in a column's cross axis resolves like 0, no visible effect). Ours cannot render that form: acme-modal owns the panel's tree.",
  "destructive-action-modal": {
    "viewport": [1100, 900],
    "geist": {
      "side": "geist",
      "page": "destructive-action-modal",
      "marker": "[data-geist-modal]",
      "theme": "light",
      "textParts": ["title", "subtitle", "header", "content", "body", "stack", "band", "bandText", "bandContent", "field", "prompt", "phrase", "errorText", "cancel", "cancelLabel", "confirm", "confirmLabel"],
      "children": {
        "body": ".body|[data-geist-modal-body]",
        "content": ".content|[data-geist-modal-body] > div",
        "header": ".header|[data-geist-modal-header]",
        "title": ".title|[data-geist-modal-title]",
        "subtitle": ".subtitle|[data-geist-modal-subtitle]",
        "stack": ".stack|.space-y-6",
        "band": "acme-note >> .note|[data-slot=note]",
        "bandBody": "acme-note >> .body|[data-slot=note-body]",
        "bandIcon": "acme-note >> .icon|[data-slot=note-icon]",
        "bandText": "acme-note >> .text|[data-slot=note-body] > .flex-col",
        "bandContent": "acme-note >> .content|[data-slot=note-content]",
        "field": ".field|.items-stretch",
        "prompt": ".prompt|.items-stretch > label",
        "phrase": ".phrase|.items-stretch b",
        "inputWrap": "acme-input >> .wrap|[data-geist-input-wrapper]",
        "input": "acme-input >> input|[data-geist-input]",
        "error": ".stack > acme-error >> .error|.space-y-6 > [data-geist-error]",
        "errorIcon": ".stack > acme-error >> .icon|.space-y-6 > [data-geist-error] > [aria-hidden]",
        "errorText": ".stack > acme-error >> .text|.space-y-6 > [data-geist-error] > .break-words",
        "actions": ".actions|[data-geist-modal-actions]",
        "cancel": "acme-button:first-of-type >> .btn|[data-geist-modal-action]:first-of-type",
        "cancelLabel": "acme-button:first-of-type >> .label|[data-geist-modal-action]:first-of-type > .truncate",
        "confirm": "acme-button:last-of-type >> .btn|[data-geist-modal-action]:last-of-type",
        "confirmLabel": "acme-button:last-of-type >> .label|[data-geist-modal-action]:last-of-type > .truncate",
        "confirmPrefix": "acme-button:last-of-type >> .prefix|[data-geist-modal-action]:last-of-type > [aria-hidden]",
        "spinner": "acme-button:last-of-type >> acme-spinner >> .spinner|[data-glyph=circular]"
      }
    },
    "ours": {
      "side": "ours",
      "page": "destructive-action-modal",
      "host": "acme-destructive-modal",
      "ours": "acme-modal >> .modal",
      "theme": "light",
      "textParts": ["title", "subtitle", "header", "content", "body", "stack", "band", "bandText", "bandContent", "field", "prompt", "phrase", "errorText", "cancel", "cancelLabel", "confirm", "confirmLabel"],
      "children": {
        "body": ".body|[data-geist-modal-body]",
        "content": ".content|[data-geist-modal-body] > div",
        "header": ".header|[data-geist-modal-header]",
        "title": ".title|[data-geist-modal-title]",

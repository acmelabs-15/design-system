        ],
        "textProps": {
          "suffix": [
            "margin-left"
          ]
        }
      }
    },
    "menu-section": {
      "geist": {
        "side": "geist",
        "page": "menu-section",
        "marker": "data-geist-menu-section",
        "children": {
          "heading": ".heading|.text-label-14",
          "group": ".group|ul"
        },
        "states": [
          ""
        ]
      },
      "ours": {
        "side": "ours",
        "page": "menu-section",
        "host": "acme-menu[open] acme-menu-section",
        "ours": ".section",
        "children": {
          "heading": ".heading|.text-label-14",
          "group": ".group|ul"

                              "class": "relative shrink-0 block bg-white w-1.5 h-3.5 rounded-[1px] ring-1 ring-gray-alpha-500 dark-theme:ring-black after:absolute after:-inset-2 transition-[scale] duration-100 data-dragging:has-[:focus]:scale-120 has-[:focus-visible]:scale-120 has-[:focus-visible]:outline-2 has-[:focus-visible]:outline-offset-2 has-[:focus-visible]:outline-(--ds-focus-color)",
                              "attrs": { "data-orientation": "horizontal", "data-index": "0", "id": "base-ui-sketch-full-thumb", "style": "position:absolute;inset-inline-start:50%;top:50%;translate:-50% -50%", "data-slot": "slider-thumb" },

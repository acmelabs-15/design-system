// Type-checking only, for the editor and `tsc --noEmit`. dist/ is emitted by scripts/build.ts,
// which builds its own program with its own rootDir/outDir; setting them here fenced src/ off from
// the tools/ that .geist.ts mappings import at authoring time.
{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ESNext", "ES2022", "DOM", "DOM.Iterable"],
    "experimentalDecorators": true,
    "useDefineForClassFields": false,
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["bun", "node"],
    "plugins": [
      { "name": "ts-lit-plugin", "tags": ["lit", "element", "css"] },
      {
        "name": "typescript-lit-html-plugin",
        "tags": ["html", "template", "css"]
      }
    ]
  },
  "include": ["src", "tools", "docs-src"]
}
